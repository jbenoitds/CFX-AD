# Variant of the functional, sourced by every run_*.sh.
#
# CFLAMBD is the fraction of the normalized Becke-Roussel hole curvature mixed into Q:
#   0.0 = CFX (default)
#   0.2 = CFXmix
# It is read when JAX first traces the functional, so each run uses one value. To run the
# other variant without editing this file:
#
#     CFLAMBD=0.2 bash run_energies.sh
#
# Output filenames carry the lambda value, so the two variants never overwrite each other.
export CFLAMBD=${CFLAMBD:-0.0}

case "$CFLAMBD" in
  0.0) CELL_NAME="CFX (lambda=0.0)" ;;
  0.2) CELL_NAME="CFXmix (lambda=0.2)" ;;
  *)   CELL_NAME="lambda=$CFLAMBD" ;;
esac
